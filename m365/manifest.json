{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.22/MicrosoftTeams.schema.json",
  "manifestVersion": "1.22",
  "version": "1.0.0",
  "id": "${{AAD_APP_CLIENT_ID}}",
  "developer": {
    "name": "Your organization",
    "websiteUrl": "https://${{BOT_DOMAIN}}",
    "privacyUrl": "https://${{BOT_DOMAIN}}/privacy",
    "termsOfUseUrl": "https://${{BOT_DOMAIN}}/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "IT Helper",
    "full": "IT Helper custom engine agent"
  },
  "description": {
    "short": "Triage common IT support requests.",
    "full": "A Microsoft Agent Framework custom engine agent backed by Microsoft Foundry that checks service status, searches IT knowledge, and helps manage sample tickets."
  },
  "accentColor": "#0F6CBD",
  "copilotAgents": {
    "customEngineAgents": [
      {
        "id": "${{AAD_APP_CLIENT_ID}}",
        "type": "bot"
      }
    ]
  },
  "bots": [
    {
      "botId": "${{AAD_APP_CLIENT_ID}}",
      "scopes": [
        "personal"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "${{BOT_DOMAIN}}"
  ]
}
